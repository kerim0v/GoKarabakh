# Copy to .env and fill in. Never commit .env.

# Required in production: a long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# Optional, signs password reset links (defaults to JWT_SECRET_KEY)
SECRET_KEY=
JWT_ACCESS_TOKEN_HOURS=8

# True only on your own machine: allows a missing JWT_SECRET_KEY and shows debug pages
DEBUG=False

# SQLite file in instance/ by default; use a Postgres URL in production
DATABASE_URL=sqlite:///gokarabakh.db

# Where the frontend lives (used in email links) and which origins may call the API
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=*
# True behind Render/Heroku/nginx so rate limits see the real client IP
TRUST_PROXY=False

# Uploaded photos (defaults to instance/uploads). Use a persistent disk in production.
UPLOAD_FOLDER=

# Email. Leave SMTP_HOST empty to print emails to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
MAIL_FROM=GoKarabakh <no-reply@example.com>

# Display rates for the currency switch (prices are stored and charged in AZN)
AZN_PER_USD=1.70
AZN_PER_EUR=1.98

# AI trip planner. Leave ANTHROPIC_API_KEY empty to switch the feature off.
# Get a key at console.anthropic.com. Never put it in the frontend.
ANTHROPIC_API_KEY=
# claude-opus-5-5 plans best; claude-haiku-5-5 is about 40x cheaper per token
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_DAILY_LIMIT=10
